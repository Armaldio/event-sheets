{
  "extends": "../../tooling/typescript/vue.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "types",
    "rootDir": "src",
    "lib": ["ES2022", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "references": [{ "path": "../schema" }],
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
