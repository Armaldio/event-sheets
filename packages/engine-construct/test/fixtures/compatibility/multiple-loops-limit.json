        { "id": "repeat", "objectClass": "System", "sid": "inner-repeat", "parameters": { "count": 100 } }
      ],
      "actions": [
        { "id": "set-eventvar-value", "objectClass": "System", "sid": "remember-inner-index", "parameters": { "variable": "lastIndex", "value": "LoopIndex" } }
      ]
    }]
  },
  "hostInstances": [],
  "expectedBehavior": "Nested loops stop with a partial result when their combined loop-frame count exceeds 10000.",
  "expectedSelections": [],
